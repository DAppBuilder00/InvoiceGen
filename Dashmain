<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InvoiceFlow — Smart Invoice Generator</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080b14;
  --surface: #0d1220;
  --card: #111827;
  --card2: #161f30;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --accent: #6c63ff;
  --accent2: #a78bfa;
  --teal: #2dd4bf;
  --pink: #f472b6;
  --text: #f1f5f9;
  --muted: #64748b;
  --muted2: #94a3b8;
  --success: #34d399;
  --warning: #fbbf24;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Outfit', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

/* animated background orbs */
body::before {
  content: '';
  position: fixed;
  top: -30%;
  left: -20%;
  width: 700px;
  height: 700px;
  background: radial-gradient(circle, rgba(108,99,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  animation: orbFloat 12s ease-in-out infinite alternate;
  z-index: 0;
}
body::after {
  content: '';
  position: fixed;
  bottom: -20%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(45,212,191,0.09) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  animation: orbFloat2 15s ease-in-out infinite alternate;
  z-index: 0;
}

@keyframes orbFloat {
  0% { transform: translate(0,0) scale(1); }
  100% { transform: translate(60px, 80px) scale(1.15); }
}
@keyframes orbFloat2 {
  0% { transform: translate(0,0) scale(1); }
  100% { transform: translate(-50px, -60px) scale(1.1); }
}

/* ── HEADER ── */
header {
  position: relative;
  z-index: 10;
  background: rgba(8,11,20,0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  padding: 0 36px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}
.logo-icon {
  width: 34px;
  height: 34px;
  background: linear-gradient(135deg, var(--accent), var(--teal));
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  box-shadow: 0 0 20px rgba(108,99,255,0.4);
}
.logo-text {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  font-weight: 700;
  background: linear-gradient(90deg, #fff 0%, var(--accent2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.logo-badge {
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--teal);
  background: rgba(45,212,191,0.1);
  border: 1px solid rgba(45,212,191,0.2);
  padding: 2px 7px;
  border-radius: 20px;
}

.header-right { display: flex; align-items: center; gap: 12px; }
.total-display {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--teal);
  background: rgba(45,212,191,0.08);
  border: 1px solid rgba(45,212,191,0.18);
  padding: 6px 16px;
  border-radius: 8px;
  letter-spacing: 0.02em;
}

/* ── BUTTONS ── */
.btn {
  font-family: 'Outfit', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: none;
  border-radius: 8px;
  padding: 9px 18px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 6px;
}
.btn-primary {
  background: linear-gradient(135deg, var(--accent), #8b5cf6);
  color: #fff;
  box-shadow: 0 4px 15px rgba(108,99,255,0.35);
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(108,99,255,0.5);
}
.btn-teal {
  background: linear-gradient(135deg, var(--teal), #0891b2);
  color: #fff;
  box-shadow: 0 4px 15px rgba(45,212,191,0.3);
}
.btn-teal:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(45,212,191,0.45);
}
.btn-ghost {
  background: var(--card2);
  border: 1px solid var(--border2);
  color: var(--muted2);
}
.btn-ghost:hover { background: var(--card); color: var(--text); border-color: var(--accent); }

/* ── LAYOUT ── */
.workspace {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 440px;
  min-height: calc(100vh - 64px);
}

/* ── EDITOR ── */
.editor {
  padding: 32px 36px;
  overflow-y: auto;
  border-right: 1px solid var(--border);
}

.section {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 20px;
  transition: border-color 0.2s;
  animation: fadeSlideIn 0.4s ease both;
}
.section:hover { border-color: var(--border2); }

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.section:nth-child(1) { animation-delay: 0.05s; }
.section:nth-child(2) { animation-delay: 0.10s; }
.section:nth-child(3) { animation-delay: 0.15s; }
.section:nth-child(4) { animation-delay: 0.20s; }
.section:nth-child(5) { animation-delay: 0.25s; }

.section-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}
.section-icon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}
.icon-purple { background: rgba(108,99,255,0.15); }
.icon-teal   { background: rgba(45,212,191,0.12); }
.icon-pink   { background: rgba(244,114,182,0.12); }
.icon-yellow { background: rgba(251,191,36,0.12); }

.section-title {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted2);
}

/* ── FORM FIELDS ── */
.form-grid {
  display: grid;
  gap: 12px;
}
.form-grid.cols2 { grid-template-columns: 1fr 1fr; }
.form-grid.cols3 { grid-template-columns: 1fr 1fr 1fr; }

.field label {
  display: block;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 6px;
}
.field input,
.field textarea,
.field select {
  width: 100%;
  padding: 10px 14px;
  background: var(--bg);
  border: 1.5px solid var(--border2);
  border-radius: 10px;
  font-family: 'Outfit', sans-serif;
  font-size: 0.88rem;
  color: var(--text);
  outline: none;
  transition: all 0.2s;
  -webkit-appearance: none;
}
.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: var(--accent);
  background: rgba(108,99,255,0.05);
  box-shadow: 0 0 0 3px rgba(108,99,255,0.12);
}
.field textarea { resize: vertical; min-height: 72px; line-height: 1.6; }
.field select option { background: var(--card); }

/* ── LINE ITEMS ── */
.items-table-head {
  display: grid;
  grid-template-columns: 2.5fr 70px 110px 50px 32px;
  gap: 8px;
  padding: 0 4px 8px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 8px;
}
.items-table-head span {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
}
.items-table-head span:last-child { text-align: center; }

.line-item {
  display: grid;
  grid-template-columns: 2.5fr 70px 110px 50px 32px;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
  animation: fadeSlideIn 0.25s ease both;
}
.line-item input {
  width: 100%;
  padding: 9px 12px;
  background: var(--bg);
  border: 1.5px solid var(--border2);
  border-radius: 9px;
  font-family: 'Outfit', sans-serif;
  font-size: 0.84rem;
  color: var(--text);
  outline: none;
  transition: all 0.2s;
}
.line-item input:focus {
  border-color: var(--teal);
  background: rgba(45,212,191,0.04);
  box-shadow: 0 0 0 3px rgba(45,212,191,0.1);
}
.item-amount {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78rem;
  color: var(--teal);
  text-align: right;
  padding-right: 4px;
}
.remove-btn {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  background: rgba(244,114,182,0.08);
  border: 1px solid rgba(244,114,182,0.15);
  color: var(--pink);
  font-size: 0.75rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
}
.remove-btn:hover { background: rgba(244,114,182,0.18); border-color: var(--pink); }

.add-item {
  width: 100%;
  margin-top: 6px;
  padding: 10px;
  background: rgba(108,99,255,0.04);
  border: 1.5px dashed rgba(108,99,255,0.25);
  border-radius: 10px;
  color: var(--accent2);
  font-family: 'Outfit', sans-serif;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.04em;
}
.add-item:hover {
  background: rgba(108,99,255,0.1);
  border-color: var(--accent);
  color: #fff;
}

/* ── PREVIEW PANEL ── */
.preview-panel {
  background: var(--surface);
  border-left: 1px solid var(--border);
  padding: 28px 24px;
  overflow-y: auto;
}
.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.preview-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 6px;
}
.live-dot {
  width: 6px;
  height: 6px;
  background: var(--success);
  border-radius: 50%;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(52,211,153,0.4); }
  50% { opacity: 0.8; box-shadow: 0 0 0 5px rgba(52,211,153,0); }
}

/* ── INVOICE DOCUMENT ── */
#invoice-doc {
  background: #ffffff;
  color: #0f172a;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.05);
}

.doc-top-bar {
  height: 5px;
  background: linear-gradient(90deg, #6c63ff, #2dd4bf, #f472b6);
}

.doc-body { padding: 32px 28px; }

.doc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
}

.doc-brand-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.2;
}
.doc-brand-details {
  font-size: 0.72rem;
  color: #64748b;
  line-height: 1.8;
  margin-top: 5px;
  white-space: pre-line;
}

.doc-invoice-meta { text-align: right; }
.doc-inv-word {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  background: linear-gradient(135deg, #6c63ff, #2dd4bf);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}
.doc-inv-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  color: #64748b;
  margin: 4px 0;
}
.doc-dates {
  font-size: 0.72rem;
  color: #64748b;
  line-height: 1.8;
}
.doc-dates strong { color: #0f172a; font-weight: 600; }

.doc-status {
  display: inline-block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.58rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 20px;
  margin-top: 6px;
  background: #fef9c3;
  color: #854d0e;
  border: 1px solid #fde68a;
}

.doc-divider {
  height: 1px;
  background: linear-gradient(90deg, #6c63ff33, #2dd4bf33, #f472b633);
  margin: 20px 0;
}

.doc-parties {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}
.doc-party-tag {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #6c63ff;
  margin-bottom: 5px;
}
.doc-party-name {
  font-size: 0.88rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 2px;
}
.doc-party-addr {
  font-size: 0.72rem;
  color: #64748b;
  line-height: 1.7;
  white-space: pre-line;
}

.doc-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
.doc-table thead tr {
  background: #f8fafc;
}
.doc-table th {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #64748b;
  padding: 9px 10px;
  text-align: left;
  border-bottom: 1px solid #e2e8f0;
}
.doc-table th:nth-child(2),
.doc-table th:nth-child(3),
.doc-table th:nth-child(4) { text-align: right; }
.doc-table td {
  padding: 10px 10px;
  font-size: 0.78rem;
  color: #334155;
  border-bottom: 1px solid #f1f5f9;
  vertical-align: middle;
}
.doc-table td:nth-child(2),
.doc-table td:nth-child(3) {
  text-align: right;
  font-family: 'JetBrains Mono', monospace;
  color: #64748b;
  font-size: 0.73rem;
}
.doc-table td:nth-child(4) {
  text-align: right;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 600;
  color: #0f172a;
  font-size: 0.78rem;
}

.doc-totals-wrap {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24px;
}
.doc-totals { width: 210px; }
.doc-total-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.76rem;
  color: #64748b;
  padding: 5px 0;
}
.doc-total-row span:last-child {
  font-family: 'JetBrains Mono', monospace;
}
.doc-grand {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  background: linear-gradient(135deg, rgba(108,99,255,0.08), rgba(45,212,191,0.08));
  border-radius: 10px;
  border: 1px solid rgba(108,99,255,0.15);
  margin-top: 8px;
}
.doc-grand-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.doc-grand-amount {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.05rem;
  font-weight: 700;
  background: linear-gradient(135deg, #6c63ff, #2dd4bf);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.doc-footer {
  background: #f8fafc;
  border-radius: 10px;
  padding: 14px 16px;
  font-size: 0.72rem;
  color: #64748b;
  line-height: 1.75;
  white-space: pre-line;
}
.doc-footer strong { color: #0f172a; }
.doc-footer-empty {
  font-size: 0.72rem;
  color: #cbd5e1;
  text-align: center;
  font-style: italic;
  padding: 10px 0;
}

@media print {
  header, .editor, .preview-label, .preview-header, .btn { display: none !important; }
  body, .workspace, .preview-panel { background: #fff !important; }
  .preview-panel { padding: 0 !important; }
  #invoice-doc { box-shadow: none !important; border-radius: 0 !important; }
  .doc-top-bar { display: block !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="logo">
    <div class="logo-icon">⚡</div>
    <div class="logo-text">InvoiceFlow</div>
    <div class="logo-badge">Pro</div>
  </div>
  <div class="header-right">
    <div class="total-display" id="header-total">$0.00</div>
    <button class="btn btn-ghost" onclick="resetForm()">↺ New</button>
    <button class="btn btn-teal" onclick="window.print()">⎙ Export PDF</button>
  </div>
</header>

<!-- WORKSPACE -->
<div class="workspace">

  <!-- EDITOR -->
  <div class="editor">

    <!-- Your Business -->
    <div class="section">
      <div class="section-head">
        <div class="section-icon icon-purple">🏢</div>
        <div class="section-title">Your Business</div>
      </div>
      <div class="form-grid">
        <div class="field">
          <label>Company / Name</label>
          <input type="text" id="from-name" placeholder="Acme Creative Studio" oninput="update()">
        </div>
        <div class="field">
          <label>Address, Email & Phone</label>
          <textarea id="from-details" placeholder="123 Main Street, New York, NY 10001&#10;hello@acme.com  ·  +1 (555) 000-0000" oninput="update()"></textarea>
        </div>
      </div>
    </div>

    <!-- Bill To -->
    <div class="section">
      <div class="section-head">
        <div class="section-icon icon-teal">👤</div>
        <div class="section-title">Bill To</div>
      </div>
      <div class="form-grid">
        <div class="field">
          <label>Client Name</label>
          <input type="text" id="to-name" placeholder="Client Corporation" oninput="update()">
        </div>
        <div class="field">
          <label>Client Address</label>
          <textarea id="to-details" placeholder="456 Business Ave, Suite 100&#10;San Francisco, CA 94107" oninput="update()"></textarea>
        </div>
      </div>
    </div>

    <!-- Invoice Details -->
    <div class="section">
      <div class="section-head">
        <div class="section-icon icon-yellow">📋</div>
        <div class="section-title">Invoice Details</div>
      </div>
      <div class="form-grid cols3">
        <div class="field">
          <label>Invoice #</label>
          <input type="text" id="inv-number" value="INV-001" oninput="update()">
        </div>
        <div class="field">
          <label>Issue Date</label>
          <input type="date" id="inv-date" oninput="update()">
        </div>
        <div class="field">
          <label>Due Date</label>
          <input type="date" id="due-date" oninput="update()">
        </div>
      </div>
      <div class="form-grid cols2" style="margin-top:12px">
        <div class="field">
          <label>Currency</label>
          <select id="currency" onchange="update()">
            <option value="$">🇺🇸 USD ($)</option>
            <option value="€">🇪🇺 EUR (€)</option>
            <option value="£">🇬🇧 GBP (£)</option>
            <option value="¥">🇯🇵 JPY (¥)</option>
            <option value="₹">🇮🇳 INR (₹)</option>
            <option value="A$">🇦🇺 AUD (A$)</option>
            <option value="C$">🇨🇦 CAD (C$)</option>
          </select>
        </div>
        <div class="field">
          <label>Tax / VAT Rate (%)</label>
          <input type="number" id="tax-rate" value="0" min="0" max="100" step="0.1" oninput="update()">
        </div>
      </div>
    </div>

    <!-- Line Items -->
    <div class="section">
      <div class="section-head">
        <div class="section-icon icon-teal">📦</div>
        <div class="section-title">Line Items</div>
      </div>
      <div class="items-table-head">
        <span>Description</span>
        <span>Qty</span>
        <span style="text-align:right">Unit Price</span>
        <span style="text-align:right">Amount</span>
        <span></span>
      </div>
      <div id="line-items"></div>
      <button class="add-item" onclick="addItem()">＋ Add Line Item</button>
    </div>

    <!-- Notes -->
    <div class="section">
      <div class="section-head">
        <div class="section-icon icon-pink">💬</div>
        <div class="section-title">Payment Info & Notes</div>
      </div>
      <div class="field">
        <label>Notes shown on invoice</label>
        <textarea id="notes" placeholder="Bank Transfer: Chase Bank · Acct: 000123456 · Routing: 021000021&#10;&#10;Payment is due within 30 days. Thank you for your business! 🙌" oninput="update()"></textarea>
      </div>
    </div>

  </div>

  <!-- PREVIEW PANEL -->
  <div class="preview-panel">
    <div class="preview-header">
      <div class="preview-label">
        <div class="live-dot"></div>
        Live Preview
      </div>
      <button class="btn btn-primary" style="font-size:0.72rem; padding:7px 14px;" onclick="window.print()">⎙ Print</button>
    </div>

    <div id="invoice-doc">
      <div class="doc-top-bar"></div>
      <div class="doc-body">

        <div class="doc-header">
          <div class="doc-brand">
            <div class="doc-brand-name" id="p-from-name">Your Business</div>
            <div class="doc-brand-details" id="p-from-details"></div>
          </div>
          <div class="doc-invoice-meta">
            <div class="doc-inv-word">INVOICE</div>
            <div class="doc-inv-num" id="p-inv-num">INV-001</div>
            <div class="doc-dates" id="p-dates"></div>
            <div><span class="doc-status">● Unpaid</span></div>
          </div>
        </div>

        <div class="doc-divider"></div>

        <div class="doc-parties">
          <div>
            <div class="doc-party-tag">From</div>
            <div class="doc-party-name" id="p-from-name2">—</div>
            <div class="doc-party-addr" id="p-from-addr"></div>
          </div>
          <div>
            <div class="doc-party-tag">Bill To</div>
            <div class="doc-party-name" id="p-to-name">—</div>
            <div class="doc-party-addr" id="p-to-addr"></div>
          </div>
        </div>

        <table class="doc-table">
          <thead>
            <tr>
              <th>Description</th>
              <th>Qty</th>
              <th>Rate</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody id="p-items"></tbody>
        </table>

        <div class="doc-totals-wrap">
          <div class="doc-totals">
            <div class="doc-total-row"><span>Subtotal</span><span id="p-subtotal">$0.00</span></div>
            <div class="doc-total-row" id="tax-row" style="display:none"><span id="tax-label">Tax (0%)</span><span id="p-tax">$0.00</span></div>
            <div class="doc-grand">
              <span class="doc-grand-label">Total Due</span>
              <span class="doc-grand-amount" id="p-total">$0.00</span>
            </div>
          </div>
        </div>

        <div id="p-notes-wrap">
          <div class="doc-footer-empty">Add payment info or notes above…</div>
        </div>

      </div>
    </div>
  </div>

</div>

<script>
let items = [
  { desc: '', qty: 1, price: 0 },
  { desc: '', qty: 1, price: 0 }
];

const fmt = d => d.toISOString().split('T')[0];
const today = new Date();
const due30 = new Date(today); due30.setDate(due30.getDate() + 30);
document.getElementById('inv-date').value = fmt(today);
document.getElementById('due-date').value = fmt(due30);

function renderItems() {
  const cur = document.getElementById('currency').value;
  const container = document.getElementById('line-items');
  container.innerHTML = '';
  items.forEach((item, i) => {
    const div = document.createElement('div');
    div.className = 'line-item';
    const amt = (item.qty * item.price).toFixed(2);
    div.innerHTML = `
      <input type="text" placeholder="Service or product…" value="${escHtml(item.desc)}"
        oninput="items[${i}].desc=this.value;updatePreview()">
      <input type="number" value="${item.qty}" min="0" step="1"
        oninput="items[${i}].qty=parseFloat(this.value)||0;updatePreview()">
      <input type="number" value="${item.price === 0 ? '' : item.price}" min="0" step="0.01" placeholder="0.00"
        oninput="items[${i}].price=parseFloat(this.value)||0;updatePreview()">
      <div class="item-amount">${cur}${amt}</div>
      <button class="remove-btn" onclick="removeItem(${i})">✕</button>
    `;
    container.appendChild(div);
  });
  updatePreview();
}

function addItem() {
  items.push({ desc: '', qty: 1, price: 0 });
  renderItems();
}
function removeItem(i) {
  if (items.length > 1) { items.splice(i, 1); renderItems(); }
}

function escHtml(str) {
  return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function formatDate(str) {
  if (!str) return '';
  const [y,m,d] = str.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[+m-1]} ${+d}, ${y}`;
}

function update() { updatePreview(); }

function updatePreview() {
  const cur = document.getElementById('currency').value;
  const taxRate = parseFloat(document.getElementById('tax-rate').value) || 0;

  // Header total
  let subtotal = items.reduce((s, it) => s + it.qty * it.price, 0);
  const taxAmt = subtotal * taxRate / 100;
  const total = subtotal + taxAmt;
  document.getElementById('header-total').textContent = `${cur}${total.toFixed(2)}`;

  // From
  const fromName = document.getElementById('from-name').value || 'Your Business';
  document.getElementById('p-from-name').textContent = fromName;
  document.getElementById('p-from-name2').textContent = fromName;
  document.getElementById('p-from-details').textContent = document.getElementById('from-details').value;
  document.getElementById('p-from-addr').textContent = document.getElementById('from-details').value;

  // To
  document.getElementById('p-to-name').textContent = document.getElementById('to-name').value || '—';
  document.getElementById('p-to-addr').textContent = document.getElementById('to-details').value;

  // Invoice meta
  document.getElementById('p-inv-num').textContent = document.getElementById('inv-number').value || 'INV-001';
  const issueDate = document.getElementById('inv-date').value;
  const dueDate = document.getElementById('due-date').value;
  let datesHtml = '';
  if (issueDate) datesHtml += `Issued: <strong>${formatDate(issueDate)}</strong><br>`;
  if (dueDate)   datesHtml += `Due: <strong>${formatDate(dueDate)}</strong>`;
  document.getElementById('p-dates').innerHTML = datesHtml;

  // Line items
  const tbody = document.getElementById('p-items');
  tbody.innerHTML = '';
  items.forEach(item => {
    const amt = item.qty * item.price;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${item.desc || '<em style="color:#cbd5e1;font-style:italic">—</em>'}</td>
      <td>${item.qty}</td>
      <td>${cur}${item.price.toFixed(2)}</td>
      <td>${cur}${amt.toFixed(2)}</td>
    `;
    tbody.appendChild(tr);
  });

  // Totals
  document.getElementById('p-subtotal').textContent = `${cur}${subtotal.toFixed(2)}`;
  document.getElementById('p-tax').textContent = `${cur}${taxAmt.toFixed(2)}`;
  document.getElementById('p-total').textContent = `${cur}${total.toFixed(2)}`;
  document.getElementById('tax-label').textContent = `Tax (${taxRate}%)`;
  document.getElementById('tax-row').style.display = taxRate > 0 ? 'flex' : 'none';

  // Notes
  const notes = document.getElementById('notes').value;
  const wrap = document.getElementById('p-notes-wrap');
  if (notes.trim()) {
    wrap.innerHTML = `<div class="doc-footer">${notes.replace(/\n/g,'<br>')}</div>`;
  } else {
    wrap.innerHTML = `<div class="doc-footer-empty">Add payment info or notes above…</div>`;
  }

  // Also re-render amounts in editor
  document.querySelectorAll('.item-amount').forEach((el, i) => {
    if (items[i]) el.textContent = `${cur}${(items[i].qty * items[i].price).toFixed(2)}`;
  });
}

function resetForm() {
  if (!confirm('Start a new invoice? Current data will be cleared.')) return;
  ['from-name','from-details','to-name','to-details','notes'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('inv-number').value = 'INV-001';
  document.getElementById('inv-date').value = fmt(new Date());
  document.getElementById('due-date').value = fmt(due30);
  document.getElementById('tax-rate').value = '0';
  document.getElementById('currency').value = '$';
  items = [{ desc:'', qty:1, price:0 }, { desc:'', qty:1, price:0 }];
  renderItems();
  updatePreview();
}

renderItems();
updatePreview();
</script>
</body>
</html>
